{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "disaster-risk-2027-registration",
  "main": "api/registration.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SITE_ORIGIN": "https://cellis212.github.io"
  },
  "secrets": {
    "required": ["REGISTRATION_CODE"]
  },
  "durable_objects": {
    "bindings": [{ "name": "REGISTRATIONS", "class_name": "ConferenceRegistrations" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConferenceRegistrations"] }],
  "ratelimits": [
    { "name": "REGISTRATION_ATTEMPTS", "namespace_id": "20270430", "simple": { "limit": 15, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
